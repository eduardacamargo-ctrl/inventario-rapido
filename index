<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Inventário rápido</title>
<style>
:root{--navy:#13233a;--blue:#1769e0;--blue2:#0c55bf;--green:#087f55;--red:#bb2635;--muted:#637083;--line:#dce3ec;--bg:#f5f7fa;--card:#fff;--shadow:0 12px 32px rgba(23,38,62,.10)}
*{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--navy);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:16px} button,input{font:inherit} button{border:0;cursor:pointer} .app{width:min(100%,540px);min-height:100svh;margin:auto;background:var(--bg);padding:env(safe-area-inset-top) 18px calc(32px + env(safe-area-inset-bottom))}
header{padding:18px 2px 16px;display:flex;align-items:start;justify-content:space-between;gap:12px} h1{font-size:25px;line-height:1.1;margin:0 0 5px;letter-spacing:-.6px} header p{margin:0;color:var(--muted);font-size:14px}.count{font-size:13px;font-weight:750;background:#e7f0ff;color:var(--blue2);padding:8px 10px;border-radius:999px;white-space:nowrap}
.steps{display:flex;gap:8px;margin:2px 0 18px}.step{flex:1;border-radius:10px;background:#e6ebf1;color:#778396;padding:9px 10px;font-weight:700;font-size:13px;text-align:center}.step.active{background:var(--blue);color:#fff}.step.done{background:#d9f3e8;color:var(--green)}
.card{background:var(--card);border:1px solid #e7ebf0;border-radius:18px;padding:18px;box-shadow:var(--shadow)}.screen{display:none}.screen.active{display:block}.section-label{display:block;color:var(--muted);font-size:13px;font-weight:760;text-transform:uppercase;letter-spacing:.6px;margin-bottom:9px}.camera-box{height:245px;border-radius:14px;overflow:hidden;background:#172237;position:relative;display:grid;place-items:center;color:#dce7f8;text-align:center}.camera-box video{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}.camera-help{position:relative;padding:25px;max-width:280px}.camera-icon{font-size:34px;margin-bottom:9px}.scan-frame{display:none;position:absolute;width:64%;height:48%;border:3px solid #fff;border-radius:12px;box-shadow:0 0 0 100vmax rgba(0,0,0,.18)}.camera-running .scan-frame{display:block}.camera-running .camera-help{display:none}.hint{font-size:13px;line-height:1.45;color:var(--muted);margin:12px 0 16px}.btn{min-height:54px;border-radius:12px;font-weight:800;font-size:16px;padding:12px 16px;width:100%;transition:.18s transform,.18s background}.btn:active{transform:scale(.98)}.primary{background:var(--blue);color:#fff}.primary:hover{background:var(--blue2)}.secondary{background:#e9f1ff;color:var(--blue2)}.danger{background:#fff0f1;color:var(--red)}.outline{background:#fff;border:1px solid #cfd7e2;color:var(--navy)}.button-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.divider{display:flex;align-items:center;gap:12px;color:#8994a3;font-size:12px;font-weight:700;margin:15px 0}.divider:before,.divider:after{content:"";height:1px;background:var(--line);flex:1}.field{margin:14px 0}.field label{display:block;font-size:14px;font-weight:760;margin:0 0 7px}.field input{width:100%;height:58px;border:2px solid #cbd5e1;border-radius:12px;padding:0 14px;background:#fff;color:var(--navy);font-size:18px;outline:none}.field input:focus{border-color:var(--blue);box-shadow:0 0 0 3px #dceaff}.code-box{background:#f1f5fa;border-radius:12px;padding:13px 14px}.code-box small{display:block;color:var(--muted);font-weight:700;margin-bottom:4px}.code-value{font-size:19px;font-weight:800;letter-spacing:.4px;word-break:break-all}.actions{display:grid;gap:10px;margin-top:18px}.recent{margin-top:20px}.recent-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.recent h2{margin:0;font-size:16px}.recent-list{display:grid;gap:8px}.recent-empty{padding:16px 10px;color:var(--muted);font-size:14px;text-align:center}.record{background:#fff;border:1px solid #e4e9ef;border-radius:12px;padding:11px 12px;display:grid;grid-template-columns:1fr auto;gap:3px 8px}.record-code{font-weight:800}.record-qty{font-size:18px;font-weight:850;color:var(--blue2);grid-row:1/3;grid-column:2;align-self:center}.record-time{color:var(--muted);font-size:12px}.link-button{background:transparent;color:var(--blue2);font-size:13px;font-weight:800;padding:3px}.session-summary{text-align:center;padding:8px 0 2px}.big-number{font-weight:850;font-size:48px;letter-spacing:-2px;color:var(--blue)}.session-summary p{margin:0;color:var(--muted)}.success{width:64px;height:64px;border-radius:50%;margin:2px auto 12px;display:grid;place-items:center;background:#d9f3e8;color:var(--green);font-size:31px;font-weight:800}.toast{position:fixed;z-index:5;left:50%;bottom:24px;transform:translate(-50%,120px);width:min(calc(100% - 36px),470px);padding:13px 16px;background:#172237;color:#fff;border-radius:12px;text-align:center;font-weight:700;box-shadow:var(--shadow);transition:transform .25s}.toast.show{transform:translate(-50%,0)}.hidden{display:none!important}
</style>
</head>
<body>
<main class="app">
<header><div><h1>Inventário rápido</h1><p>Registre os itens usando a câmera.</p></div><span class="count" id="countBadge">0 itens</span></header>
<div class="steps"><div class="step active" id="stepScan">1. Escanear</div><div class="step" id="stepQty">2. Quantidade</div></div>
<section class="screen active" id="scanScreen"><div class="card"><span class="section-label">Próximo item</span><div class="camera-box" id="cameraBox"><video id="video" muted playsinline></video><div class="scan-frame"></div><div class="camera-help"><div class="camera-icon">▣</div><strong>Aponte a câmera para o código de barras</strong><div class="hint" style="color:#dce7f8;margin:8px 0 0">A leitura é feita automaticamente.</div></div></div><p class="hint">Use a câmera do celular para ler o código. Se preferir, informe-o manualmente abaixo.</p><button class="btn primary" id="openCameraBtn">Abrir câmera e escanear</button><div class="divider">ou</div><div class="field"><label for="manualCode">Digitar código de barras</label><input id="manualCode" inputmode="numeric" autocomplete="off" placeholder="Ex.: 7891234567890"></div><button class="btn secondary" id="manualNextBtn">Continuar com este código</button></div></section>
<section class="screen" id="quantityScreen"><div class="card"><span class="section-label">Item lido</span><div class="code-box"><small>CÓDIGO DE BARRAS</small><div class="code-value" id="selectedCode">—</div></div><div class="field"><label for="quantityInput">Quantidade encontrada</label><input id="quantityInput" inputmode="decimal" type="number" min="0.001" step="any" placeholder="0"></div><p class="hint">O horário será registrado automaticamente ao salvar.</p><div class="actions"><button class="btn primary" id="continueBtn">Salvar e continuar</button><button class="btn outline" id="endFromQuantityBtn">Salvar e encerrar inventário</button><button class="btn secondary" id="backBtn">Voltar para leitura</button></div></div></section>
<section class="screen" id="endScreen"><div class="card"><div class="session-summary"><div class="success">✓</div><span class="section-label">Inventário encerrado</span><div class="big-number" id="finalCount">0</div><p>lançamentos registrados nesta sessão</p></div><div class="actions"><button class="btn primary" id="exportBtn">Baixar arquivo CSV</button><button class="btn secondary" id="newSessionBtn">Iniciar novo inventário</button></div></div></section>
<section class="recent"><div class="recent-head"><h2>Últimos lançamentos</h2><button class="link-button" id="undoBtn">Desfazer último</button></div><div class="recent-list" id="recentList"><div class="recent-empty">Nenhum item registrado ainda.</div></div></section>
</main><div class="toast" id="toast"></div>
<script>
(() => {
  const storageKey = 'inventario-rapido-v1';
  let records = JSON.parse(localStorage.getItem(storageKey) || '[]');
  let selectedCode = '';
  let stream = null, detector = null, scanning = false, detectionTimer = null;
  const $ = id => document.getElementById(id);
  const screens = {scan:$('scanScreen'), quantity:$('quantityScreen'), end:$('endScreen')};
  const video = $('video');
  function escapeHTML(s){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#039;','"':'&quot;'}[c]));}
  function formatTime(iso){return new Intl.DateTimeFormat('pt-BR',{dateStyle:'short',timeStyle:'short'}).format(new Date(iso));}
  function toast(message){const t=$('toast');t.textContent=message;t.classList.add('show');clearTimeout(t._timer);t._timer=setTimeout(()=>t.classList.remove('show'),2600);}
  function save(){localStorage.setItem(storageKey, JSON.stringify(records));}
  function refresh(){
    $('countBadge').textContent = `${records.length} ${records.length===1?'item':'itens'}`;
    $('undoBtn').classList.toggle('hidden', !records.length);
    $('recentList').innerHTML = records.length ? records.slice(-5).reverse().map(r=>`<div class="record"><div class="record-code">${escapeHTML(r.code)}</div><div class="record-qty">${escapeHTML(r.quantity)}</div><div class="record-time">${formatTime(r.timestamp)}</div></div>`).join('') : '<div class="recent-empty">Nenhum item registrado ainda.</div>';
  }
  function setSteps(screen){$('stepScan').className='step'+(screen==='scan'?' active':screen==='quantity'?' done':' done');$('stepQty').className='step'+(screen==='quantity'?' active':screen==='end'?' done':'');}
  function show(name){Object.entries(screens).forEach(([key,el])=>el.classList.toggle('active',key===name));setSteps(name);if(name!=='scan')stopCamera();}
  function selectCode(code){code=String(code).trim();if(!code)return toast('Informe um código de barras.');selectedCode=code;$('selectedCode').textContent=code;$('quantityInput').value='';show('quantity');setTimeout(()=>$('quantityInput').focus(),160);}
  function addRecord(andEnd=false){const quantity=$('quantityInput').value.trim();if(!quantity || Number(quantity)<=0){toast('Informe uma quantidade válida.');$('quantityInput').focus();return;}records.push({code:selectedCode,quantity,timestamp:new Date().toISOString()});save();refresh();toast('Item salvo.');if(andEnd){$('finalCount').textContent=records.length;show('end');}else{selectedCode='';$('manualCode').value='';show('scan');setTimeout(()=>$('openCameraBtn').focus(),100);}}
  async function startCamera(){
    if(!navigator.mediaDevices?.getUserMedia){toast('A câmera não está disponível neste navegador.');return;}
    if(!('BarcodeDetector' in window)){toast('Leitura automática não suportada aqui. Digite o código ou use outro navegador.');return;}
    try{
      detector = new BarcodeDetector({formats:['ean_13','ean_8','code_128','code_39','upc_a','upc_e','itf','codabar']});
      stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'}},audio:false});video.srcObject=stream;await video.play();scanning=true;$('cameraBox').classList.add('camera-running');$('openCameraBtn').textContent='Câmera aberta — aponte para o código';detectLoop();
    }catch(e){toast('Não foi possível abrir a câmera. Verifique a permissão.');}
  }
  async function detectLoop(){
    if(!scanning)return;
    try {const codes=await detector.detect(video);if(codes.length&&codes[0].rawValue){stopCamera();selectCode(codes[0].rawValue);return;}}catch(e){}
    detectionTimer=setTimeout(detectLoop,180);
  }
  function stopCamera(){scanning=false;clearTimeout(detectionTimer);$('cameraBox').classList.remove('camera-running');$('openCameraBtn').textContent='Abrir câmera e escanear';if(stream){stream.getTracks().forEach(t=>t.stop());stream=null;}video.srcObject=null;}
  function csv(){const rows=[['codigo_barras','quantidade','horario'],...records.map(r=>[r.code,r.quantity,new Date(r.timestamp).toLocaleString('pt-BR')])];return '\ufeff'+rows.map(row=>row.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(';')).join('\r\n');}
  function download(){if(!records.length){toast('Não há lançamentos para exportar.');return;}const blob=new Blob([csv()],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');const stamp=new Date().toISOString().slice(0,10);a.href=url;a.download=`inventario-${stamp}.csv`;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);toast('Arquivo CSV baixado com sucesso.');}
  $('openCameraBtn').addEventListener('click',startCamera);
  $('manualNextBtn').addEventListener('click',()=>selectCode($('manualCode').value));
  $('manualCode').addEventListener('keydown',e=>{if(e.key==='Enter')selectCode($('manualCode').value)});
  $('continueBtn').addEventListener('click',()=>addRecord(false));
  $('endFromQuantityBtn').addEventListener('click',()=>addRecord(true));
  $('backBtn').addEventListener('click',()=>{show('scan');$('manualCode').focus()});
  $('quantityInput').addEventListener('keydown',e=>{if(e.key==='Enter')addRecord(false)});
  $('exportBtn').addEventListener('click',download);
  $('newSessionBtn').addEventListener('click',()=>{if(records.length&&!confirm('Iniciar uma nova sessão? Os lançamentos atuais permanecem neste aparelho até você limpá-los.'))return;show('scan');});
  $('undoBtn').addEventListener('click',()=>{if(!records.length)return;const removed=records.pop();save();refresh();toast(`Último item removido: ${removed.code}`)});
  refresh();
})();
</script>
</body></html>
